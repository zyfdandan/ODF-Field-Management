# Copy to deploy.env and fill in values before deploy_to_server.ps1
# Lines starting with # are ignored. Values may be quoted.
# NEVER commit deploy.env with real passwords.

DEPLOY_HOST=192.168.1.10
DEPLOY_USER=deploy
DEPLOY_PASSWORD=
DEPLOY_REMOTE_DIR=/opt/netbox-field-portal

# PuTTY host key fingerprint (plink -batch requires this)
# Get once: plink user@host → accept key → copy fingerprint here
DEPLOY_HOSTKEY=SHA256:YOUR_HOST_KEY_FINGERPRINT

# Set to 1 to skip uploading node-red-local.tar.gz even if present
# SKIP_NODERED=0

# Set to 1 to build Node-RED bundle before packaging (build_package.ps1 only)
# BUILD_NODERED=1
